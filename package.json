{
  "name": "bibin-shop-frontend",
  "version": "0.1.99",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "prod": "rm -rf .next && pnpm build && pnpm start",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "next lint",
    "prettier": "prettier . --write",
    "prettier:check": "prettier . --check",
    "test": "pnpm lint && pnpm prettier:check",
    "generate:type:oauth": "pnpm openapi-typescript https://stg-api.bibin.shop/api-docs/spree/oauth.yaml --output lib/api/oauth.ts",
    "generate:type:storefront": "pnpm openapi-typescript https://stg-api.bibin.shop/api-docs/spree/storefront.yaml --output lib/api/storefront.ts",
    "generate:type": "rm -rf lib/api/ && pnpm generate:type:oauth && pnpm generate:type:storefront && pnpm prettier"
  },
